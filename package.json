{
  "name": "taskhive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:validate": "DATABASE_URL=\"postgresql://taskhive:taskhive@localhost:5432/taskhive?schema=public\" prisma validate",
    "prisma:generate": "DATABASE_URL=\"postgresql://taskhive:taskhive@localhost:5432/taskhive?schema=public\" prisma generate",
    "verify": "pnpm lint && pnpm typecheck && pnpm prisma:validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "@upstash/qstash": "^2.11.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "mongodb": "^7.6.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.0"
}
