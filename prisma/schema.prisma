generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationAppealStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}

enum TaskStatus {
  DRAFT
  OPEN
  PENDING_APPROVAL
  PENDING_PAYMENT
  ASSIGNED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum FulfillmentMode {
  LOCAL
  REMOTE
}

enum HiringMode {
  BIDDING
  FIXED_PRICE
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  INVALIDATED
}

enum PaymentStatus {
  UNPAID
  CHECKOUT_STARTED
  PAID_PENDING_COMPLETION
  RELEASED
  REFUNDED
  DISPUTED
}

/// The 24-hour payment retry hold after a Poster selects one Tasker.
enum AssignmentStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ModerationStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  firebaseUid   String?    @unique
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  phone         String?
  phoneVerified Boolean    @default(false)
  ageAttestedAt DateTime?
  image         String?
  status        UserStatus @default(PENDING_VERIFICATION)
  isAdmin       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  taskerVerification TaskerVerification?
  postedTasks   Task[]     @relation("PostedTasks")
  bids          Bid[]
  taskRequests  TaskRequest[]
  assignments   Assignment[] @relation("AssignedTasker")
  givenReviews  Review[]   @relation("GivenReviews")
  receivedReviews Review[] @relation("ReceivedReviews")
  reportsMade   Report[]   @relation("ReportsMade")
  reportsAgainst Report[]  @relation("ReportsAgainst")
  disputes      Dispute[]  @relation("DisputesOpened")
  adminActions  AdminAction[]
  chatsOpened   TaskChat[] @relation("ChatsOpened")
  chatMessages  ChatMessage[] @relation("ChatMessages")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  bio                String?
  community          String?
  contactNumber      String?
  locationLabel      String?
  latitude           Float?
  longitude          Float?
  isPosterEnabled    Boolean  @default(true)
  isTaskerEnabled    Boolean  @default(true)
  skills             String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Stronger Tasker identity check. The provider retains identity documents;
/// TaskHive stores only the decision, provider reference, rejection reason,
/// and the Tasker's own appeal note — never identity documents or images.
model TaskerVerification {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  status                  VerificationStatus       @default(NOT_STARTED)
  providerReference       String?
  rejectionReason         String?
  appealStatus            VerificationAppealStatus @default(NONE)
  appealCount             Int                      @default(0)
  appealNote              String?
  submittedAt             DateTime?
  decidedAt               DateTime?
  appealedAt              DateTime?
  applicationsWithdrawnAt DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  tasks Task[]
}

model Task {
  id          String     @id @default(cuid())
  posterId    String
  categoryId  String?
  title       String
  description String
  budgetCents Int
  currency    String     @default("PHP")
  deadline    DateTime?
  /// Public approximate area shown to everyone before hire.
  locationLabel String?
  /// Exact service address. Never exposed before a successful payment on an
  /// active assignment; only the Poster and the assigned Tasker may read it.
  addressLine String?
  latitude    Float?
  longitude   Float?
  fulfillmentMode FulfillmentMode
  hiringMode  HiringMode
  status      TaskStatus @default(DRAFT)
  publishedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  poster      User       @relation("PostedTasks", fields: [posterId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id])
  bids        Bid[]
  taskRequests TaskRequest[]
  assignment  Assignment?
  payments    Payment[]
  reviews     Review[]
  reports     Report[]
  disputes    Dispute[]
  chats       TaskChat[]
}

model Bid {
  id          String    @id @default(cuid())
  taskId      String
  taskerId    String
  amountCents Int
  message     String
  estimatedTime String?
  status      BidStatus @default(SUBMITTED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker      User      @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  @@unique([taskId, taskerId])
}

model TaskRequest {
  id        String    @id @default(cuid())
  taskId    String
  taskerId  String
  message   String?
  status    BidStatus @default(SUBMITTED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker    User      @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  @@unique([taskId, taskerId])
}

model Assignment {
  id        String   @id @default(cuid())
  taskId    String   @unique
  taskerId  String
  status    AssignmentStatus @default(PENDING_PAYMENT)
  /// The 24-hour window; a successful payment activates the assignment.
  holdExpiresAt DateTime?
  activatedAt DateTime?
  expiredAt   DateTime?
  /// Completion evidence submitted by the Tasker.
  completedAt    DateTime?
  completionNote String?
  completionUrl  String?
  confirmedAt    DateTime?
  /// The single 24-hour Poster reminder, recorded so a retry cannot resend it.
  reminderSentAt DateTime?
  /// Undisputed auto-release deadline, 48 hours after completion was submitted.
  autoReleaseAt  DateTime?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker    User     @relation("AssignedTasker", fields: [taskerId], references: [id], onDelete: Cascade)

  @@index([status, holdExpiresAt])
  @@index([status, autoReleaseAt])
}

model Payment {
  id                    String        @id @default(cuid())
  taskId                String        @unique
  posterId              String
  /// Provider name and the safe reference/id for its checkout session.
  provider              String        @default("unconfigured")
  providerCheckoutId    String?
  checkoutUrl           String?
  attemptCount          Int           @default(0)
  amountCents           Int
  platformFeeCents      Int
  currency              String        @default("PHP")
  status                PaymentStatus @default(UNPAID)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  task                  Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events                PaymentEvent[]

  @@index([provider, providerCheckoutId])
}

/// Idempotency log for provider callbacks; safe metadata only, never card data.
model PaymentEvent {
  id                String   @id @default(cuid())
  provider          String
  eventId           String
  type              String
  providerReference String?
  paymentId         String?
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
}

model Payout {
  id               String   @id @default(cuid())
  paymentId        String   @unique
  taskerId         String
  amountCents      Int
  platformFeeCents Int
  /// Provider transfer reference once the payout is actually sent.
  providerReference String?
  releasedAt       DateTime?
  createdAt        DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  taskId     String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  /// Hidden until both participants submit or the 14-day deadline passes.
  publishAt   DateTime?
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([taskId, reviewerId, revieweeId])
  @@index([taskId, publishedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reportedUserId String?
  taskId         String?
  /// Set when a chat message is reported; keeps the offending message in history.
  messageId      String?
  reason         String
  status         ModerationStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reporter       User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?            @relation("ReportsAgainst", fields: [reportedUserId], references: [id])
  task           Task?            @relation(fields: [taskId], references: [id])
  message        ChatMessage?     @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

/// One conversation per signed-in user per task. The Poster is the other
/// participant; only the opener and the Poster may read or write.
model TaskChat {
  id        String        @id @default(cuid())
  taskId    String
  openerId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  opener    User          @relation("ChatsOpened", fields: [openerId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@unique([taskId, openerId])
  @@index([taskId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  chat      TaskChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation("ChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([chatId, createdAt])
}

model Dispute {
  id        String           @id @default(cuid())
  taskId    String
  openedById String
  reason    String
  status    ModerationStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  openedBy  User             @relation("DisputesOpened", fields: [openedById], references: [id], onDelete: Cascade)
}

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetType String
  targetId  String
  notes     String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model UploadAsset {
  id           String   @id @default(cuid())
  ownerId      String
  cloudinaryId String
  url          String
  purpose      String
  createdAt    DateTime @default(now())
}
